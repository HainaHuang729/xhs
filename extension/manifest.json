{
  "manifest_version": 3,
  "name": "XHS Album Builder",
  "version": "0.1.1",
  "description": "在小红书收藏页注入智能专辑整理按钮。",
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["xhs-album-builder.page.js"],
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ]
    }
  ]
}
