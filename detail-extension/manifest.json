{
  "manifest_version": 3,
  "name": "XHS Detail Extractor Sample",
  "version": "0.1.0",
  "description": "Extract sample body text and visible comments from Xiaohongshu favorite notes.",
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["xhs-detail-extractor.sample.js"],
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ]
    }
  ]
}
